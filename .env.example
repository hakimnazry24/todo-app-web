# Copy to .env before running `docker compose up`.

# ---------- PostgreSQL ----------
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo_password
POSTGRES_DB=todo
# Host port Postgres is published on (change if 5432 is already in use).
POSTGRES_PORT=5432

# ---------- Backend ----------
# Secret used to sign session JWTs. REQUIRED — compose refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Session lifetime in minutes (the app requires 30).
SESSION_TTL_MINUTES=30

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# ---------- Frontend ----------
FRONTEND_PORT=8080
