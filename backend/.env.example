# Copy to backend/.env for running the API (and the Prisma CLI) outside Docker.
# Assumes the compose Postgres is published on localhost:5432.

DATABASE_URL="postgresql://todo:todo_password@localhost:5432/todo?schema=public"
PORT=3000
NODE_ENV=development
JWT_SECRET=dev-secret-change-me
SESSION_TTL_MINUTES=30
CORS_ORIGIN=http://localhost:5173
